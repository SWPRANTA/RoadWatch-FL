<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="14dp"
    app:strokeColor="@color/surface_border"
    app:strokeWidth="1dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- File Format Badge -->
            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="CSV"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:fontFamily="@font/inter"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:background="@drawable/badge_background"
                android:layout_marginEnd="12dp" />

            <!-- Title & Subtitle -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/file_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="recording_2024.csv"
                    android:textColor="@color/on_surface"
                    android:textSize="13.5sp"
                    android:fontFamily="@font/inter"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="middle" />

                <TextView
                    android:id="@+id/file_details"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10 KB · 2024-01-01 12:00"
                    android:textColor="@color/on_surface_muted"
                    android:textSize="11sp"
                    android:fontFamily="@font/jetbrains_mono"
                    android:layout_marginTop="3dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Action Buttons Row -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/surface_border"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end|center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_view"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="TABLE"
                style="@style/Widget.Material3.Button.TextButton"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingHorizontal="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_share"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="SHARE"
                style="@style/Widget.Material3.Button.TextButton"
                android:textColor="@color/secondary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingHorizontal="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="DELETE"
                style="@style/Widget.Material3.Button.TextButton"
                android:textColor="@color/error"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingHorizontal="12dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
