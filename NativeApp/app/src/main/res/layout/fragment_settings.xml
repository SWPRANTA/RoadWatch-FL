<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        app:title="Sampling &amp; Telemetry"
        app:titleTextColor="@color/primary"
        app:subtitle="SENSOR HARDWARE &amp; BUFFER CONFIG"
        app:subtitleTextColor="@color/on_surface_variant" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/surface_border" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <!-- Card 0: DEVICE IDENTIFIER -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="14dp"
                app:strokeColor="@color/surface_border"
                app:strokeWidth="1dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="DEVICE IDENTIFIER"
                        android:textColor="@color/primary"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Prefix prepended to saved sensor recording filenames (e.g., Pixel_7, Car_A)."
                        android:textColor="@color/on_surface_muted"
                        android:textSize="11.5sp"
                        android:fontFamily="@font/inter"
                        android:layout_marginBottom="14dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_device_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Device Name"
                        app:boxStrokeColor="@color/primary"
                        app:hintTextColor="@color/primary"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_device_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:textColor="@color/on_surface"
                            android:fontFamily="@font/jetbrains_mono"
                            android:textSize="14sp" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/tv_preview_filename"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Preview: recording_all_sensors_....csv"
                        android:textColor="@color/on_surface_muted"
                        android:textSize="11sp"
                        android:fontFamily="@font/jetbrains_mono"
                        android:layout_marginTop="8dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Card: BLUETOOTH MULTI-DEVICE SYNC -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_bluetooth_sync"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="14dp"
                app:strokeColor="@color/surface_border"
                app:strokeWidth="1dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="BLUETOOTH MULTI-DEVICE SYNC"
                                android:textColor="@color/primary"
                                android:textSize="12sp"
                                android:fontFamily="@font/inter"
                                android:textStyle="bold"
                                android:letterSpacing="0.08"
                                android:layout_marginBottom="2dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Sync Start/Pause/Stop across handheld and pocket devices."
                                android:textColor="@color/on_surface_muted"
                                android:textSize="11.5sp"
                                android:fontFamily="@font/inter" />

                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_bt_sync"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp" />

                    </LinearLayout>

                    <!-- Expanded container shown when sync is enabled -->
                    <LinearLayout
                        android:id="@+id/layout_bt_sync_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/surface_border"
                            android:layout_marginVertical="12dp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="STATUS:"
                                android:textColor="@color/on_surface_muted"
                                android:textSize="11sp"
                                android:fontFamily="@font/inter"
                                android:textStyle="bold"
                                android:letterSpacing="0.06"
                                android:layout_marginEnd="8dp" />

                            <TextView
                                android:id="@+id/tv_bt_status"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Disconnected"
                                android:textColor="@color/on_surface_variant"
                                android:textSize="12sp"
                                android:fontFamily="@font/jetbrains_mono" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_bt_connect"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_weight="1"
                                android:text="CONNECT PEER"
                                app:backgroundTint="@color/primary"
                                android:textColor="@color/on_primary"
                                android:textSize="12sp"
                                android:fontFamily="@font/inter"
                                android:textStyle="bold"
                                app:cornerRadius="8dp"
                                android:layout_marginEnd="6dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_bt_disconnect"
                                android:layout_width="0dp"
                                android:layout_height="44dp"
                                android:layout_weight="1"
                                android:text="DISCONNECT"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:textColor="@color/error"
                                app:strokeColor="@color/error"
                                android:textSize="12sp"
                                android:fontFamily="@font/inter"
                                android:textStyle="bold"
                                app:cornerRadius="8dp"
                                android:layout_marginStart="6dp"
                                android:visibility="gone" />

                        </LinearLayout>

                        <View
                            android:id="@+id/divider_bt_latency"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/surface_border"
                            android:layout_marginVertical="12dp"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/layout_bt_latency"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="BLUETOOTH LATENCY &amp; CLOCK BENCHMARK"
                                android:textColor="@color/tertiary"
                                android:textSize="11.5sp"
                                android:fontFamily="@font/inter"
                                android:textStyle="bold"
                                android:letterSpacing="0.08"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Measure real-time RFCOMM round-trip latency, trigger delay, and clock offset between devices."
                                android:textColor="@color/on_surface_muted"
                                android:textSize="11sp"
                                android:fontFamily="@font/inter"
                                android:layout_marginBottom="10dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_test_bt_latency"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:text="TEST BLUETOOTH LATENCY"
                                app:backgroundTint="@color/tertiary"
                                android:textColor="@color/on_tertiary"
                                android:textSize="12sp"
                                android:fontFamily="@font/inter"
                                android:textStyle="bold"
                                app:cornerRadius="8dp" />

                            <TextView
                                android:id="@+id/tv_bt_latency_result"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="@color/tertiary"
                                android:textSize="12sp"
                                android:fontFamily="@font/jetbrains_mono"
                                android:lineSpacingExtra="3dp"
                                android:layout_marginTop="8dp" />

                        </LinearLayout>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Tip: Pair devices in Android Bluetooth settings first. Keep app open on both phones (screen can be turned off)."
                            android:textColor="@color/on_surface_muted"
                            android:textSize="11sp"
                            android:fontFamily="@font/inter"
                            android:layout_marginTop="10dp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Card 1: HARDWARE SENSOR INTERVAL -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="14dp"
                app:strokeColor="@color/border_white"
                app:strokeWidth="1.5dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="HARDWARE SENSOR INTERVAL"
                        android:textColor="@color/primary"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rate at which native hardware delivers raw sensor measurements."
                        android:textColor="@color/on_surface_muted"
                        android:textSize="11.5sp"
                        android:fontFamily="@font/inter"
                        android:layout_marginBottom="14dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Interval (ms)"
                            app:boxStrokeColor="@color/primary"
                            app:hintTextColor="@color/primary"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_hw_interval"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:textColor="@color/on_surface"
                                android:fontFamily="@font/jetbrains_mono"
                                android:textSize="14sp" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:id="@+id/tv_hw_freq"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="50.0 Hz"
                            android:textColor="@color/primary"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/jetbrains_mono"
                            android:layout_marginStart="16dp" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/surface_border"
                        android:layout_marginVertical="14dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="QUICK SELECT PRESETS"
                        android:textColor="@color/on_surface_muted"
                        android:textSize="10.5sp"
                        android:fontFamily="@font/inter"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chip_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="8dp"
                        app:chipSpacingVertical="6dp"
                        app:singleSelection="true" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Card 2: SOFTWARE SAMPLING INTERVAL -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="14dp"
                app:strokeColor="@color/border_white"
                app:strokeWidth="1.5dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SOFTWARE SAMPLING INTERVAL"
                        android:textColor="@color/secondary"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rate at which data frames are sampled and written into dataset logs."
                        android:textColor="@color/on_surface_muted"
                        android:textSize="11.5sp"
                        android:fontFamily="@font/inter"
                        android:layout_marginBottom="14dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.textfield.TextInputLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Interval (ms)"
                            app:boxStrokeColor="@color/secondary"
                            app:hintTextColor="@color/secondary"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_sw_interval"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="number"
                                android:textColor="@color/on_surface"
                                android:fontFamily="@font/jetbrains_mono"
                                android:textSize="14sp" />

                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:id="@+id/tv_sw_freq"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="50.0 Hz"
                            android:textColor="@color/secondary"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:fontFamily="@font/jetbrains_mono"
                            android:layout_marginStart="16dp" />

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Card 3: MAX FREQUENCY BENCHMARK -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="14dp"
                app:strokeColor="@color/surface_border"
                app:strokeWidth="1dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MAX FREQUENCY BENCHMARK"
                        android:textColor="@color/tertiary"
                        android:textSize="12sp"
                        android:fontFamily="@font/inter"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Empirically measure the maximum hardware sampling capability of this device."
                        android:textColor="@color/on_surface_muted"
                        android:textSize="11.5sp"
                        android:fontFamily="@font/inter"
                        android:layout_marginBottom="14dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_test"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="TEST HARDWARE CAPABILITY"
                        app:backgroundTint="@color/tertiary"
                        android:textColor="@color/on_tertiary"
                        android:textSize="13sp"
                        android:fontFamily="@font/inter"
                        android:textStyle="bold"
                        app:cornerRadius="10dp" />

                    <TextView
                        android:id="@+id/tv_test_result"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/tertiary"
                        android:textSize="13.5sp"
                        android:fontFamily="@font/jetbrains_mono"
                        android:layout_marginTop="12dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Bottom Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_reset"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="RESET"
                    android:layout_marginEnd="8dp"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:textColor="@color/on_surface_variant"
                    app:strokeColor="@color/surface_border"
                    app:cornerRadius="10dp"
                    android:fontFamily="@font/inter"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_apply"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="APPLY"
                    android:layout_marginStart="8dp"
                    app:backgroundTint="@color/primary"
                    android:textColor="@color/on_primary"
                    app:cornerRadius="10dp"
                    android:fontFamily="@font/inter"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>
