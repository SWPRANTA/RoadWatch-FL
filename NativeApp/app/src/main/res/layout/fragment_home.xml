<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/surface"
        app:title="RoadWatch FL"
        app:titleTextColor="@color/primary"
        app:subtitle="EDGE SENSING &amp; TELEMETRY"
        app:subtitleTextColor="@color/on_surface_variant" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/surface_border" />

    <!-- Scrollable content area -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- 1. SENSOR ARRAY -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SENSOR ARRAY"
                android:textColor="@color/on_surface_muted"
                android:textSize="11sp"
                android:fontFamily="@font/inter"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/sensor_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp" />

            <!-- 2. RECORDING FREQUENCY CARD -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_frequency"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="14dp"
                app:strokeColor="@color/surface_border"
                app:strokeWidth="1dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="RECORDING TELEMETRY"
                            android:textColor="@color/tertiary"
                            android:textSize="11sp"
                            android:fontFamily="@font/inter"
                            android:textStyle="bold"
                            android:letterSpacing="0.12" />

                        <TextView
                            android:id="@+id/tv_bt_sync_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SYNC: READY"
                            android:textColor="@color/primary"
                            android:textSize="10.5sp"
                            android:fontFamily="@font/inter"
                            android:textStyle="bold"
                            android:letterSpacing="0.08"
                            android:background="@drawable/badge_background"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:layout_marginEnd="6dp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tv_status_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="STANDBY"
                            android:textColor="@color/on_surface_variant"
                            android:textSize="10.5sp"
                            android:fontFamily="@font/inter"
                            android:textStyle="bold"
                            android:letterSpacing="0.08"
                            android:background="@drawable/badge_background"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="12dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="LIVE RATE"
                                android:textColor="@color/on_surface_muted"
                                android:textSize="10sp"
                                android:fontFamily="@font/inter"
                                android:letterSpacing="0.08" />

                            <TextView
                                android:id="@+id/tv_live_freq"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0.0 Hz"
                                android:textColor="@color/primary"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/jetbrains_mono"
                                android:layout_marginTop="2dp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.2"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TARGET RATE"
                                android:textColor="@color/on_surface_muted"
                                android:textSize="10sp"
                                android:fontFamily="@font/inter"
                                android:letterSpacing="0.08" />

                            <TextView
                                android:id="@+id/tv_target_freq"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="50.0 Hz (20ms)"
                                android:textColor="@color/on_surface"
                                android:textSize="14.5sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/jetbrains_mono"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.9"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SAMPLES"
                                android:textColor="@color/on_surface_muted"
                                android:textSize="10sp"
                                android:fontFamily="@font/inter"
                                android:letterSpacing="0.08" />

                            <TextView
                                android:id="@+id/tv_sample_count"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:textColor="@color/secondary"
                                android:textSize="14.5sp"
                                android:textStyle="bold"
                                android:fontFamily="@font/jetbrains_mono"
                                android:layout_marginTop="4dp" />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 3. SENSOR LIVE DATA CARD -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LIVE DATA STREAM"
                android:textColor="@color/on_surface_muted"
                android:textSize="11sp"
                android:fontFamily="@font/inter"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="18dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="14dp"
                app:strokeColor="@color/surface_border"
                app:strokeWidth="1dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_data"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Select a sensor"
                            android:textColor="@color/on_surface"
                            android:textSize="14.5sp"
                            android:fontFamily="@font/jetbrains_mono"
                            android:lineSpacingMultiplier="1.2"
                            android:layout_marginBottom="10dp" />

                        <TextView
                            android:id="@+id/tv_timestamp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TS: 0"
                            android:textColor="@color/on_surface_muted"
                            android:textSize="10.5sp"
                            android:fontFamily="@font/jetbrains_mono" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_active_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:text="NORMAL"
                        android:textColor="@color/primary"
                        android:textSize="11sp"
                        android:fontFamily="@font/inter"
                        android:textStyle="bold"
                        android:letterSpacing="0.08"
                        android:background="@drawable/badge_background"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="6dp"
                        android:paddingBottom="6dp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- 4. ANOMALY LABELS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ANOMALY ANNOTATIONS"
                    android:textColor="@color/on_surface_muted"
                    android:textSize="11sp"
                    android:fontFamily="@font/inter"
                    android:textStyle="bold"
                    android:letterSpacing="0.12" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add_label"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="+ ADD LABEL"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:textColor="@color/primary"
                    android:textSize="11sp"
                    android:fontFamily="@font/inter"
                    android:textStyle="bold"
                    android:paddingHorizontal="6dp" />

            </LinearLayout>

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="6dp"
                app:singleSelection="true" />

        </LinearLayout>

    </ScrollView>

    <!-- 5. PINNED BOTTOM ACTION BAR -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/surface_border" />

    <LinearLayout
        android:id="@+id/bottom_action_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">

        <!-- Vehicle Motion State Selector -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="VEHICLE STATE"
                android:textColor="@color/on_surface_muted"
                android:textSize="11sp"
                android:fontFamily="@font/inter"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggle_motion_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:checkedButton="@id/btn_state_moving">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_state_moving"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="MOVING"
                    android:textSize="11.5sp"
                    android:fontFamily="@font/inter"
                    android:textStyle="bold"
                    android:paddingHorizontal="14dp"
                    app:backgroundTint="@color/btn_state_moving_bg"
                    android:textColor="@color/btn_state_moving_text"
                    app:strokeColor="@color/btn_state_moving_stroke"
                    app:strokeWidth="1.5dp"
                    style="@style/Widget.Material3.Button.OutlinedButton" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_state_stopped"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="STOPPED"
                    android:textSize="11.5sp"
                    android:fontFamily="@font/inter"
                    android:textStyle="bold"
                    android:paddingHorizontal="14dp"
                    app:backgroundTint="@color/btn_state_stopped_bg"
                    android:textColor="@color/btn_state_stopped_text"
                    app:strokeColor="@color/btn_state_stopped_stroke"
                    app:strokeWidth="1.5dp"
                    style="@style/Widget.Material3.Button.OutlinedButton" />

            </com.google.android.material.button.MaterialButtonToggleGroup>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_pause"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="PAUSE"
                android:visibility="gone"
                android:layout_marginEnd="12dp"
                app:backgroundTint="@color/secondary"
                android:textColor="@color/background"
                android:textSize="13.5sp"
                android:textStyle="bold"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_record"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="2"
                android:text="RECORD"
                app:backgroundTint="@color/primary"
                android:textColor="@color/on_primary"
                android:textSize="14.5sp"
                android:textStyle="bold"
                app:cornerRadius="10dp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
